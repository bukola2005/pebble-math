# Copy this file to .env.local and fill both in, then restart `npm run dev`.
# Supabase dashboard → Settings → API Keys (or the "Connect" dialog).
#
# Anything prefixed VITE_ is bundled into the page and readable by every
# visitor, so only the publishable key goes here. Never a secret or
# service_role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Older name for the same key. Still read if the line above is empty, so an
# existing .env.local keeps working. New setups can leave it out.
# VITE_SUPABASE_ANON_KEY=
